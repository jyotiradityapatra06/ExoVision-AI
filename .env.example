# ExoVision AI Environment Variables Example

# Backend Settings
APP_ENV=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
PROJECT_NAME="ExoVision AI API"
API_V1_STR=/api/v1
UPLOAD_ROOT=data/uploads
REPORT_ROOT=data/reports
DATABASE_PATH=data/exovision.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
ANALYSIS_STALE_MINUTES=30
MAX_ACTIVE_ANALYSES_PER_USER=1
MAX_UPLOAD_BYTES=26214400
MAX_ANALYSES_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=524288000
TRUST_PROXY_HEADERS=false
# JSON values are [request count, window seconds].
RATE_LIMITS={"auth":[10,60],"analysis":[6,60],"upload":[10,3600],"report":[6,60],"mast_search":[30,60],"mast_download":[10,60],"ml":[30,60]}

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
